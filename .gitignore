# =============================================================================
# .gitignore exhaustivo para proyecto de web scraping de libros
# =============================================================================

# ---- Variables de entorno y credenciales ----
.env
.env.*
.env.local
.env.development
.env.production
.env.staging
*.env
secrets.json
credentials.json
service-account*.json
*.pem
*.key
*.cert
*.crt

# ---- Python ----
__pycache__/
*.py[cod]
*$py.class
*.so
*.egg
*.egg-info/
dist/
build/
eggs/
sdist/
develop-eggs/
.installed.cfg
lib/
lib64/
parts/
var/
wheels/
share/python-wheels/
*.manifest
*.spec
pip-log.txt
pip-delete-this-directory.txt

# ---- Entornos virtuales ----
venv/
.venv/
env/
ENV/
env.bak/
venv.bak/
.conda/
conda-env/

# ---- IDEs y editores ----
.vscode/
.idea/
*.swp
*.swo
*~
.project
.classpath
.settings/
*.sublime-project
*.sublime-workspace
.spyderproject
.spyproject

# ---- Sistema operativo ----
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
desktop.ini
$RECYCLE.BIN/

# ---- Pruebas y cobertura ----
htmlcov/
.tox/
.nox/
.coverage
.coverage.*
.cache
nosetests.xml
coverage.xml
*.cover
*.py,cover
.hypothesis/
.pytest_cache/
pytestdebug.log

# ---- Logs y archivos temporales ----
*.log
logs/
tmp/
temp/
*.tmp
*.bak
*.backup

# ---- Base de datos local ----
*.db
*.sqlite
*.sqlite3

# ---- Datos de scraping (pueden contener informacion sensible) ----
datos_scraping/
exportaciones/
*.csv
*.xlsx
*.xls
!ejemplo_datos/

# ---- Node.js / Frontend ----
node_modules/
.next/
out/
.nuxt/
.cache/
.parcel-cache/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
.pnpm-store/
package-lock.json
yarn.lock

# ---- Docker ----
docker-compose.override.yml
.dockerignore

# ---- Jupyter Notebooks ----
.ipynb_checkpoints/

# ---- MyPy ----
.mypy_cache/
.dmypy.json
dmypy.json

# ---- Ruff / Linters ----
.ruff_cache/

# ---- Antigravity / Gemini ----
.agents/
.gemini/
