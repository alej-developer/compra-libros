# Plantilla de variables de entorno del backend.
# Copie este archivo a .env para personalizar el puerto, los orígenes CORS
# o el tiempo de espera del scraping. Si omite una variable, se usa el
# valor predeterminado de app/configuracion.py.
#
#   cp .env.ejemplo .env

# Puerto de escucha declarado en Configuracion.puerto.
PUERTO=8000

# Origenes CORS permitidos. Pydantic Settings espera un arreglo JSON.
# Lista explicita: con credenciales no se admite el comodin '*'.
# El frontend estatico se sirve en el puerto 3000.
ORIGENES_PERMITIDOS=["http://localhost:3000","http://127.0.0.1:3000"]

# Tiempo máximo de espera de cada petición de scraping, en segundos.
TIEMPO_ESPERA_SCRAPING=8
